# Hybrid RAG Retriever Engine — environment template
# Copy to .env and fill in values before running.

# ---------------------------------------------------------------------------
# LLM / Embeddings
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Retrieval defaults
# ---------------------------------------------------------------------------
DEFAULT_VECTOR_STORE=faiss          # faiss | chroma
DEFAULT_RETRIEVER=vector_store      # vector_store | multi_query | self_query | parent_document | ensemble
TOP_K=4
SCORE_THRESHOLD=0.0
CHUNK_SIZE=500
CHUNK_OVERLAP=100
PARENT_CHUNK_SIZE=2000
CHILD_CHUNK_SIZE=400

# ---------------------------------------------------------------------------
# Storage paths
# ---------------------------------------------------------------------------
DATA_DIR=./data
STORAGE_DIR=./storage
FAISS_INDEX_DIR=./storage/faiss
CHROMA_PERSIST_DIR=./storage/chroma
DOCSTORE_DIR=./storage/docstore
COLLECTION_NAME=hybrid_rag_docs

# ---------------------------------------------------------------------------
# App / observability
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=false
ENABLE_METRICS=true
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
API_HOST=0.0.0.0
API_PORT=8000
CACHE_TTL_SECONDS=300
